rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.time < timestamp.date(2027, 1, 1);
    }

    function groupPath(gid) {
      return /databases/$(database)/documents/groups/$(gid);
    }

    function secretPath(gid, name) {
      return /databases/$(database)/documents/groups/$(gid)/secret/$(name);
    }

    function organizerPath(gid) {
      return /databases/$(database)/documents/groups/$(gid)/organizers/$(request.auth.uid);
    }

    function memberPath(gid) {
      return /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid);
    }

    function isOrganizer(gid) {
      return signedIn() && exists(organizerPath(gid));
    }

    function isMember(gid) {
      return signedIn() && (exists(memberPath(gid)) || exists(organizerPath(gid)));
    }

    function validName(s, max) {
      return s is string && s.size() > 0 && s.size() <= max;
    }

    function validKey(d, minSize) {
      return d.keys().hasOnly(['key'])
        && d.key is string
        && d.key.size() >= minSize
        && d.key.size() <= 100;
    }

    function validAssignments(a) {
      return a == null || (a is map && a.size() <= 200);
    }

    function validShowMatches(d) {
      return !('showMatches' in d) || d.showMatches is bool;
    }

    function validFixed(d) {
      return !('fixed' in d) || (d.fixed is map && d.fixed.size() <= 200);
    }

    // Keep in sync with MAX_PHOTO_CHARS.
    function validPhoto(d) {
      return !('photo' in d)
        || d.photo == ''
        || (d.photo is string
            && d.photo.size() <= 100000
            && d.photo.matches('data:image/(jpeg|webp);base64,[A-Za-z0-9+/=]+'));
    }

    // Rules can't loop over list items, so only the item count is bounded.
    function validPerson(d) {
      return d.keys().hasOnly(['name', 'household', 'items', 'photo', 'createdAt', 'updatedAt'])
        && validName(d.name, 50)
        && d.household is string && d.household.size() <= 40
        && d.items is list && d.items.size() <= 20
        && validPhoto(d)
        && d.updatedAt == request.time;
    }

    match /groups/{gid} {
      allow get: if isMember(gid);
      allow list: if false;

      allow create: if signedIn()
        && gid.size() >= 16
        && request.resource.data.keys().hasOnly(['name', 'avoidSameHousehold', 'showMatches', 'assignments', 'fixed', 'drawnAt', 'createdAt'])
        && validName(request.resource.data.name, 60)
        && request.resource.data.avoidSameHousehold is bool
        && validShowMatches(request.resource.data)
        && request.resource.data.assignments == null
        && request.resource.data.drawnAt == null
        && request.resource.data.createdAt == request.time
        && existsAfter(secretPath(gid, 'admin'))
        && existsAfter(secretPath(gid, 'family'))
        && existsAfter(organizerPath(gid));

      allow update: if isOrganizer(gid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'avoidSameHousehold', 'showMatches', 'assignments', 'fixed', 'drawnAt'])
        && validName(request.resource.data.name, 60)
        && request.resource.data.avoidSameHousehold is bool
        && validAssignments(request.resource.data.assignments)
        && validFixed(request.resource.data)
        && validShowMatches(request.resource.data);

      allow delete: if false;

      match /secret/{name} {
        allow get: if isOrganizer(gid);
        allow list: if false;
        allow create: if signedIn()
          && (name == 'admin' || name == 'family')
          && !exists(groupPath(gid))
          && existsAfter(groupPath(gid))
          && validKey(request.resource.data, name == 'admin' ? 24 : 8);
        allow update: if isOrganizer(gid)
          && name == 'family'
          && validKey(request.resource.data, 8);
        allow delete: if false;
      }

      match /organizers/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key == getAfter(secretPath(gid, 'admin')).data.key;
        allow update, delete: if false;
      }

      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key == getAfter(secretPath(gid, 'family')).data.key;
        allow update, delete: if false;
      }

      match /people/{pid} {
        allow read: if isMember(gid);

        allow create: if isOrganizer(gid)
          && validPerson(request.resource.data)
          && request.resource.data.createdAt == request.time;

        allow update: if isMember(gid)
          && validPerson(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isOrganizer(gid);
      }
    }
  }
}
